    {"type": "text", "id": "title", "x": 20, "y": 20, "width": 600, "height": 35, "text": "A fix needs two people", "originalText": "A fix needs two people", "fontSize": 28, "fontFamily": 3, "strokeColor": "#1e40af", "roughness": 1},
