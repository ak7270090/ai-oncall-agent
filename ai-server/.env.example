# Copy to .env and fill in. Never commit .env.

# "<provider>:<model>" — switch provider/model by editing these two lines only.
# e.g. openai:gpt-5.4-mini, openai:gpt-5.5, anthropic:claude-opus-5
LLM_MODEL=openai:gpt-5.4-mini
LLM_API_KEY=

# Optional cheaper, faster model for simple tasks (model routing): MCP sampling requests
# that prefer cost/speed (log summaries) and the graph steps in FAST_MODEL_STEPS.
# Empty = LLM_MODEL does everything. LLM_FAST_API_KEY defaults to LLM_API_KEY.
LLM_MODEL_FAST=
LLM_FAST_API_KEY=
# e.g. ["extract_incident_scope"]; measured: keep write_report on LLM_MODEL (it decides the cause)
FAST_MODEL_STEPS=[]

SERVER_HOST=127.0.0.1
SERVER_PORT=8000

LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# The MCP gateway (Phase 22), the only MCP endpoint (`make run-gateway`), and the names of
# its targets: it renames tools and resources after them; the AI server maps them back.
MCP_GATEWAY_URL=http://127.0.0.1:3000/mcp
MCP_GATEWAY_TARGETS=["k8s", "prometheus"]
MCP_TIMEOUT_SECONDS=30

# Sign-in (Phase 19): JSON map of API key (X-API-Key header) -> user name. Empty = no
# sign-in, everyone is "anonymous" (local dev only). New key: `make new-secret`.
# API_KEYS={"<key-of-aman>": "aman", "<key-of-neha>": "neha"}
API_KEYS={}
# MCP bearer tokens, minted per request for the signed-in user and signed with this
# private key (`make mcp-keys`; the MCP servers and the gateway hold the public JWKS).
# Required: the gateway refuses requests without a token. Issuer/audience must match theirs.
MCP_TOKEN_PRIVATE_KEY_PATH=../keys/mcp-token-private.pem
MCP_TOKEN_ISSUER=http://127.0.0.1:8000
MCP_TOKEN_AUDIENCE=oncall-mcp-server
MCP_TOKEN_TTL_SECONDS=60

# Investigation graph
DEFAULT_NAMESPACE=shop
ERROR_RATE_THRESHOLD=0.05
LATENCY_THRESHOLD_MS=1000
# A service is CPU-starved when this share of its CPU periods is throttled AND it uses at
# least CPU_MIN_USAGE_OF_LIMIT of its CPU limit (idle containers look throttled too).
CPU_THROTTLED_RATIO_THRESHOLD=0.25
CPU_MIN_USAGE_OF_LIMIT=0.15
MAX_PODS_TO_INSPECT=3
MAX_SERVICES_TO_INSPECT=3
LOG_LINES=50
MAX_FOLLOW_UP_ROUNDS=2
# Ask the MCP server to summarize long logs with this server's LLM (MCP sampling).
SUMMARIZE_LOGS=false
MAX_SAMPLINGS_PER_INVESTIGATION=6
# How long POST /actions waits for a human's approval before giving up (nothing changes).
APPROVAL_TIMEOUT_SECONDS=600
MAX_QUESTION_LENGTH=2000

# Tracing in Langfuse (https://cloud.langfuse.com or self-hosted). Leave the keys
# empty to turn tracing off. Keys: Langfuse project → Settings → API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=local
