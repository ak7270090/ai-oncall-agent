MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=9000
MCP_PATH=/mcp
MCP_LOG_LEVEL=INFO
# JSON list; needed when binding 0.0.0.0 (e.g. Docker). Empty = SDK default.
MCP_ALLOWED_HOSTS=[]

# kubernetes = real cluster + Prometheus; fake = canned incident for both (no cluster needed).
MCP_BACKEND=kubernetes
# Read-only ServiceAccount credentials written by `make mcp-kubeconfig` (never the admin kubeconfig).
MCP_KUBECONFIG_PATH=.kube/config
MCP_KUBE_REQUEST_TIMEOUT_SECONDS=10
MCP_ALLOWED_NAMESPACES=["shop"]
MCP_DEFAULT_NAMESPACE=shop

# Prometheus (kind: NodePort mapped to 127.0.0.1:9090 by `make cluster-up`).
MCP_PROMETHEUS_URL=http://127.0.0.1:9090
MCP_PROMETHEUS_TIMEOUT_SECONDS=10
# PromQL rate() window and range-query step for metric history.
MCP_METRICS_RATE_WINDOW=30s
MCP_METRICS_STEP_SECONDS=60

# get_pod_logs(summarize=true): logs shorter than this are returned raw; the summary's
# length limit; how long fetched lines are reused (the sampling retry must see the same).
MCP_LOG_SUMMARY_MIN_LINES=40
MCP_LOG_SUMMARY_MAX_TOKENS=500
MCP_LOG_CACHE_SECONDS=30

# Write tools (restart / scale / roll back), each asking a human for approval. Off by
# default; they use the mcp-operator ServiceAccount (`make mcp-kubeconfig`).
MCP_ENABLE_WRITE_TOOLS=false
MCP_OPERATOR_KUBECONFIG_PATH=.kube/operator-config
MCP_MAX_REPLICAS=5
