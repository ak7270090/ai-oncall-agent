# Settings for scripts/*.sh. Any value can be overridden by exporting it first,
# e.g. CLUSTER_NAME=test bash scripts/cluster-up.sh
CLUSTER_NAME=oncall-lab
KIND_CONFIG=kubernetes/kind-cluster.yaml
MANIFESTS_DIR=kubernetes
NAMESPACE=shop
PART_OF_LABEL=app.kubernetes.io/part-of=shop
ROLLOUT_TIMEOUT=180s
SECRET_ENV_FILE=kubernetes/secrets/payment-service.env
SECRET_ENV_EXAMPLE=kubernetes/secrets/payment-service.env.example
SERVICES_DIR=sample-services
DOCKERFILE=docker/python-service.Dockerfile
SERVICE_ENTRYPOINT=main.py
SERVICE_PORT=8080
SMOKE_TEST_SERVICE=order-service
SMOKE_TEST_LOCAL_PORT=18080
SMOKE_TEST_SERVICE_PORT=80
SMOKE_TEST_STARTUP_SECONDS=15
